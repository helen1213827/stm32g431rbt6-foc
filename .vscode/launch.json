{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug (停在 main)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/foc.elf",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "device": "STM32G431xx",
            "configFiles": [
                "${workspaceFolder}/openocd.cfg"
            ],
            "svdFile": "${workspaceFolder}/.vscode/STM32G431.svd",
            "preLaunchTask": "CMake: build",
            "runToEntryPoint": "main",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "Cortex Debug (直接运行)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/foc.elf",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "device": "STM32G431xx",
            "configFiles": [
                "${workspaceFolder}/openocd.cfg"
            ],
            "svdFile": "${workspaceFolder}/.vscode/STM32G431.svd",
            "runToEntryPoint": "main",
            "postLaunchCommands": [
                "continue"
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        }
    ]
}
